    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C3C3C8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3B42" />
    <SolidColorBrush x:Key="AccentBrush" Color="#62CDFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#003A60" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#30323B" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#2D3039" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#303138" />
    <SolidColorBrush x:Key="CardBrush" Color="#D926272E" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#EE33343D" />
