<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DevelopmentIcons.Light.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Fluent Gallery: a quiet shell with layered, translucent work surfaces. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#606060" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E3E3E3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#E9E9E9" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="CardBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F9FFFFFF" />
    <SolidColorBrush x:Key="HeroCardBrush" Color="#DDFBFAFF" />
    <SolidColorBrush x:Key="TerminalBrush" Color="#202128" />
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#D1D5DF" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedBorderBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#247A52" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="ConnectionTintBrush" Color="#F0EBFC" />
    <SolidColorBrush x:Key="ConnectionIconBrush" Color="#7045B9" />
    <SolidColorBrush x:Key="ConnectionCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ConnectionCardHoverBrush" Color="#F7F5FC" />
    <SolidColorBrush x:Key="ConnectionCardBorderBrush" Color="#E5E2ED" />
    <!-- File-category accents remain readable on the corresponding explorer surfaces. -->
    <SolidColorBrush x:Key="FileIconFolderBrush" Color="#9B6500" />
    <SolidColorBrush x:Key="FileIconGenericBrush" Color="#606060" />
    <SolidColorBrush x:Key="FileIconCodeBrush" Color="#087E8B" />
    <SolidColorBrush x:Key="FileIconConfigurationBrush" Color="#7352B7" />
    <SolidColorBrush x:Key="FileIconTextBrush" Color="#3568A8" />
    <SolidColorBrush x:Key="FileIconSpreadsheetBrush" Color="#217346" />
    <SolidColorBrush x:Key="FileIconPresentationBrush" Color="#A34B27" />
    <SolidColorBrush x:Key="FileIconPdfBrush" Color="#B43A46" />
    <SolidColorBrush x:Key="FileIconArchiveBrush" Color="#A36020" />
    <SolidColorBrush x:Key="FileIconImageBrush" Color="#8A42B0" />
    <SolidColorBrush x:Key="FileIconAudioBrush" Color="#A65324" />
    <SolidColorBrush x:Key="FileIconVideoBrush" Color="#A83B74" />
    <SolidColorBrush x:Key="FileIconExecutableBrush" Color="#4B5EA8" />
    <SolidColorBrush x:Key="FileIconDatabaseBrush" Color="#1F7762" />
    <SolidColorBrush x:Key="FileIconFontBrush" Color="#596C8C" />
    <SolidColorBrush x:Key="FileIconKeyBrush" Color="#947014" />
</ResourceDictionary>
