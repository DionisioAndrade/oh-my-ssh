<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:localization="clr-namespace:OhMySsh.Desktop.Localization"
                    xmlns:text="clr-namespace:OhMySsh.Core.Localization;assembly=OhMySsh.Core"
                    xmlns:models="clr-namespace:OhMySsh.Core.Models;assembly=OhMySsh.Core">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
        <ResourceDictionary Source="Colors.Light.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Standard controls retain the native .NET 10 Fluent templates. -->
    <FontFamily x:Key="InterfaceFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <localization:CultureToXmlLanguageConverter x:Key="CultureToXmlLanguage" />
    <Style TargetType="Window">
        <Setter Property="Language" Value="{Binding CultureName, Source={x:Static text:UiText.Current}, Converter={StaticResource CultureToXmlLanguage}, ConverterCulture=en-US, Mode=OneWay}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
        <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="GlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" /><Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="None" />
    </Style>
    <!-- Both explorers use filename hints; no file contents or Shell metadata are loaded for icons. -->
    <Style x:Key="SharedFileIconStyle" TargetType="TextBlock" BasedOn="{StaticResource GlyphStyle}">
        <Setter Property="Text" Value="&#xE7C3;" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource FileIconGenericBrush}" />
        <Setter Property="ToolTip" Value="{Binding TypeLabel}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding TypeLabel}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Folder}"><Setter Property="Text" Value="&#xE8B7;" /><Setter Property="Foreground" Value="{DynamicResource FileIconFolderBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Code}"><Setter Property="Text" Value="&#xE943;" /><Setter Property="Foreground" Value="{DynamicResource FileIconCodeBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Configuration}"><Setter Property="Text" Value="&#xE713;" /><Setter Property="Foreground" Value="{DynamicResource FileIconConfigurationBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Text}"><Setter Property="Text" Value="&#xE8A5;" /><Setter Property="Foreground" Value="{DynamicResource FileIconTextBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Spreadsheet}"><Setter Property="Text" Value="&#xE9F9;" /><Setter Property="Foreground" Value="{DynamicResource FileIconSpreadsheetBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Presentation}"><Setter Property="Text" Value="&#xE786;" /><Setter Property="Foreground" Value="{DynamicResource FileIconPresentationBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Pdf}"><Setter Property="Text" Value="&#xEA90;" /><Setter Property="Foreground" Value="{DynamicResource FileIconPdfBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Archive}"><Setter Property="Text" Value="&#xF012;" /><Setter Property="Foreground" Value="{DynamicResource FileIconArchiveBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Image}"><Setter Property="Text" Value="&#xE8B9;" /><Setter Property="Foreground" Value="{DynamicResource FileIconImageBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Audio}"><Setter Property="Text" Value="&#xEC4F;" /><Setter Property="Foreground" Value="{DynamicResource FileIconAudioBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Video}"><Setter Property="Text" Value="&#xE714;" /><Setter Property="Foreground" Value="{DynamicResource FileIconVideoBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Executable}"><Setter Property="Text" Value="&#xE71D;" /><Setter Property="Foreground" Value="{DynamicResource FileIconExecutableBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Database}"><Setter Property="Text" Value="&#xEDA2;" /><Setter Property="Foreground" Value="{DynamicResource FileIconDatabaseBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Font}"><Setter Property="Text" Value="&#xE8D2;" /><Setter Property="Foreground" Value="{DynamicResource FileIconFontBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FileKind.Key}"><Setter Property="Text" Value="&#xE8D7;" /><Setter Property="Foreground" Value="{DynamicResource FileIconKeyBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="SharedFileIconTemplate">
        <Grid Width="20" Height="20">
            <TextBlock x:Name="CategoryIcon" Style="{StaticResource SharedFileIconStyle}" />
            <Image x:Name="DevelopmentIcon" Width="18" Height="18" Stretch="Uniform" Visibility="Collapsed"
                   AutomationProperties.Name="{Binding TypeLabel}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Python}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentPythonIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Java}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentJavaIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.CSharp}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentCSharpIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Markdown}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentMarkdownIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.JavaScript}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentJavaScriptIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.TypeScript}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentTypeScriptIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Html}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentHtmlIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Css}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentCssIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Json}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentJsonIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Xml}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentXmlIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Yaml}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentYamlIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Shell}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentShellIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.PowerShell}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentPowerShellIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Sql}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentSqlIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Go}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentGoIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Rust}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentRustIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Php}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentPhpIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Ruby}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentRubyIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.C}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentCIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.CPlusPlus}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentCPlusPlusIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.DotNetProject}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentDotNetProjectIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DevelopmentKind}" Value="{x:Static models:FileDevelopmentKind.Docker}">
                <Setter TargetName="CategoryIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DevelopmentIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="DevelopmentIcon" Property="Source" Value="{DynamicResource DevelopmentDockerIcon}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="SharedFileIconPresenterStyle" TargetType="ContentControl">
        <Setter Property="Content" Value="{Binding}" />
        <Setter Property="ContentTemplate" Value="{StaticResource SharedFileIconTemplate}" />
        <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
        <Setter Property="ToolTip" Value="{Binding TypeLabel}" /><Setter Property="AutomationProperties.Name" Value="{Binding TypeLabel}" />
    </Style>
    <Style x:Key="FluentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="13,7" /><Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}" />
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7" /><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="46" /><Setter Property="Height" Value="46" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" /><Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="NavigationButtonStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="44" /><Setter Property="Margin" Value="10,2" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="15" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                        <Grid>
                            <Border x:Name="SelectionMark" Background="{DynamicResource AccentBrush}" Width="3" Height="19" CornerRadius="2" HorizontalAlignment="Left" Visibility="Collapsed" />
                            <ContentPresenter Margin="17,0,14,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SubtleBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="NavBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GalleryCardStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardBorder" Property="Opacity" Value="0.8" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeroCardStyle" TargetType="Button" BasedOn="{StaticResource GalleryCardStyle}">
        <Setter Property="Background" Value="{DynamicResource HeroCardBrush}" /><Setter Property="Margin" Value="6,0" />
    </Style>
    <Style x:Key="FilterToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Padding" Value="9,6" /><Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="FluentTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="FluentComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="10,6" /></Style>
    <Style x:Key="ConnectionListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="9,9" />
        <Setter Property="Margin" Value="0,2" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="ShowsPreview" Value="False" />
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="FileGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" /><Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="RowHeight" Value="35" /><Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="SelectionMode" Value="Single" /><Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="FileColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Padding" Value="10,7" /><Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="FontSize" Value="11" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="FileCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="10,0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="FluentTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style x:Key="FluentTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="14,8" /><Setter Property="FontSize" Value="12" /></Style>
</ResourceDictionary>
