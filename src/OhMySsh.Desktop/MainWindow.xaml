                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,22,0"><TextBlock Text="Tema do aplicativo" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Escolha como o oh-my-ssh aparece para você." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                    <ComboBox x:Name="ThemePicker" Grid.Column="1" Width="210" VerticalAlignment="Center" SelectionChanged="ThemePicker_SelectionChanged" AutomationProperties.Name="Tema do aplicativo"><ComboBoxItem Content="Usar tema do Windows" Tag="System"/><ComboBoxItem Content="Claro" Tag="Light"/><ComboBoxItem Content="Escuro" Tag="Dark"/></ComboBox>
                                </Grid>
                            </Border>
                            <TextBlock Text="Aplicativo" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,14"/>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Continuar na bandeja" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Mantenha o aplicativo aberto na área de notificação." Style="{StaticResource MutedTextStyle}" Margin="0,6,12,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Enviar para bandeja" Click="HideToTray_Click" VerticalAlignment="Center"/></Grid>
                            </Border>
                            <Button Content="Sobre o oh-my-ssh" Click="About_Click" HorizontalAlignment="Left" Margin="0,24,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}" Padding="16,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="{Binding StatusMessage}"/>
                <TextBlock Grid.Column="1" Text="oh-my-ssh  ·  0.1" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
