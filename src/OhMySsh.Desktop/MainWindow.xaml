                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.EditConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" ToolTip="Editar VPS" AutomationProperties.Name="{Binding Name, StringFormat='Editar {0}'}">
