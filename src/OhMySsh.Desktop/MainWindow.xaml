                            <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="6" /></Style></ToggleButton.Style>
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE922;" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True"><Setter Property="Text" Value="&#xE923;" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </ToggleButton>
                        </Grid>
                    </Border>
                </Grid>
                    <Grid x:Name="TerminalPage" Visibility="Collapsed" Margin="34,30">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,24"><TextBlock Text="{l:Loc Shell.Terminal}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{l:Loc Shell.TerminalDescription}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/></StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,24,0,0" ClipToBounds="True">
                            <views:TerminalWorkspaceView DataContext="{Binding TerminalWorkspace}" />
                        </Border>
                    </Grid>
                    <Grid x:Name="TransfersPage" Visibility="Collapsed" Margin="34,30">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="{l:Loc Shell.Transfers}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{l:Loc Shell.TransferDescription}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/></StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,25,0,0">
                            <views:TransferQueueView />
                        </Border>
                    </Grid>
                    <Grid x:Name="AutomationsPage" Visibility="Collapsed" Margin="34,30">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="{l:Loc Shell.Automations}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{l:Loc Shell.AutomationDescription}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/></StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,25,0,0" Padding="32">
                            <StackPanel VerticalAlignment="Center" MaxWidth="460">
                                <TextBlock Text="&#xE713;" Style="{StaticResource GlyphStyle}" FontSize="44" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,25"/>
                                <TextBlock Text="{l:Loc Shell.SimplifiedWorkflows}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:Loc Shell.AutomationFutureDetails}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" FontSize="14" LineHeight="23" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="34,30">
                            <TextBlock Text="{l:Loc Shell.Settings}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,30"/>
                            <TextBlock Text="{l:Loc Shell.Personalization}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,22,0"><TextBlock Text="{l:Loc Shell.AppTheme}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{l:Loc Shell.ThemeDescription}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                    <ComboBox x:Name="ThemePicker" Grid.Column="1" Width="210" VerticalAlignment="Center" SelectionChanged="ThemePicker_SelectionChanged" AutomationProperties.Name="{l:Loc Shell.AppTheme}"><ComboBoxItem Content="{l:Loc Shell.SystemTheme}" Tag="System"/><ComboBoxItem Content="{l:Loc Shell.LightTheme}" Tag="Light"/><ComboBoxItem Content="{l:Loc Shell.DarkTheme}" Tag="Dark"/></ComboBox>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                                        <TextBlock Text="{l:Loc Shell.Language}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{l:Loc Shell.LanguageHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock x:Name="LanguageSaveErrorText" Text="{l:Loc Shell.LanguageSaveError}" Visibility="Collapsed" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <ComboBox x:Name="LanguagePicker" Grid.Column="1" Width="210" VerticalAlignment="Center" SelectedValuePath="Tag"
                                              SelectionChanged="LanguagePicker_SelectionChanged" AutomationProperties.Name="{l:Loc Shell.Language}">
                                        <ComboBoxItem Content="{l:Loc Shell.LanguageEnglish}" Tag="en-US" />
                                        <ComboBoxItem Content="{l:Loc Shell.LanguagePortuguese}" Tag="pt-BR" />
                                        <ComboBoxItem Content="{l:Loc Shell.LanguageSpanish}" Tag="es-ES" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,12,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,22,0"><TextBlock Text="{l:Loc TerminalControls.SettingsTitle}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{l:Loc TerminalControls.SettingsDescription}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel><Button x:Name="TerminalPreferencesButton" Grid.Column="1" Content="{l:Loc TerminalControls.Customize}" Click="TerminalPreferences_Click" VerticalAlignment="Center" /></Grid>
                            </Border>
                            <TextBlock Text="{l:Loc Shell.Application}" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,14"/>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{l:Loc Shell.StayInTray}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{l:Loc Shell.TrayDescription}" Style="{StaticResource MutedTextStyle}" Margin="0,6,12,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="{l:Loc Shell.SendToTray}" Click="HideToTray_Click" VerticalAlignment="Center"/></Grid>
                            </Border>
                            <Button Content="{l:Loc Shell.About}" Click="About_Click" HorizontalAlignment="Left" Margin="0,24,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}" Padding="16,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="{Binding StatusMessage}"/>
                <TextBlock Grid.Column="1" Text="oh-my-ssh  ·  0.1" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
