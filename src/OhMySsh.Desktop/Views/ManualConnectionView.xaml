<UserControl x:Class="OhMySsh.Desktop.Views.ManualConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OhMySsh.Desktop.Localization"
             xmlns:models="clr-namespace:OhMySsh.Core.Models;assembly=OhMySsh.Core"
             FontFamily="{StaticResource InterfaceFont}" FontSize="14"
             Foreground="{DynamicResource TextPrimaryBrush}" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="QuickFieldLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0,0,0,6" />
        </Style>
        <Style x:Key="QuickTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FluentTextBoxStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="QuickPlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="12,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="20,16">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource ConnectionTintBrush}">
                    <TextBlock Text="&#xE968;" Style="{StaticResource GlyphStyle}" FontSize="23"
                               Foreground="{DynamicResource ConnectionIconBrush}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc Dialog.ManualTitle}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Dialog.ManualHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="125" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="{l:Loc Dialog.HostLabel}" Target="{Binding ElementName=QuickHostBox}"
                           Style="{StaticResource QuickFieldLabelStyle}" />
                    <Grid>
                        <TextBox x:Name="QuickHostBox" Text="{Binding ManualHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource QuickTextBoxStyle}" MaxLength="255"
                                 ToolTip="{l:Loc Dialog.HostExample}"
                                 AutomationProperties.Name="{l:Loc Dialog.ManualHost}" />
                        <TextBlock x:Name="QuickHostPlaceholder" Text="{l:Loc Dialog.HostPlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource QuickPlaceholderStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QuickHostBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="{l:Loc Dialog.PortLabel}" Target="{Binding ElementName=QuickPortBox}"
                           Style="{StaticResource QuickFieldLabelStyle}" />
                    <TextBox x:Name="QuickPortBox" Text="{Binding ManualPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource QuickTextBoxStyle}" MaxLength="5"
                             AutomationProperties.Name="{l:Loc Dialog.ManualPort}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <Label Content="{l:Loc Dialog.UsernameLabel}" Target="{Binding ElementName=QuickUsernameBox}"
                           Style="{StaticResource QuickFieldLabelStyle}" />
                    <Grid>
                        <TextBox x:Name="QuickUsernameBox" Text="{Binding ManualUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource QuickTextBoxStyle}" MaxLength="128"
                                 AutomationProperties.Name="{l:Loc Dialog.ManualUsername}" />
                        <TextBlock x:Name="QuickUsernamePlaceholder" Text="{l:Loc Dialog.UsernamePlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource QuickPlaceholderStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QuickUsernameBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <Label Content="{l:Loc Dialog.ProtocolLabel}" Target="{Binding ElementName=QuickProtocolBox}"
                           Style="{StaticResource QuickFieldLabelStyle}" />
                    <ComboBox x:Name="QuickProtocolBox" Style="{StaticResource FluentComboBoxStyle}" MinHeight="38"
                              FontSize="13" SelectedValuePath="Tag"
                              SelectedValue="{Binding ManualProtocol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{l:Loc Dialog.ManualProtocol}">
                        <ComboBoxItem Content="SSH + SFTP" Tag="{x:Static models:ConnectionProtocol.Ssh}" />
                        <ComboBoxItem Content="SFTP" Tag="{x:Static models:ConnectionProtocol.Sftp}" />
                        <ComboBoxItem Content="FTP" Tag="{x:Static models:ConnectionProtocol.Ftp}" />
                        <ComboBoxItem Content="FTPS" Tag="{x:Static models:ConnectionProtocol.Ftps}" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Expander x:Name="QuickOptionsExpander" IsExpanded="False"
                      Margin="0,8,0,0" Padding="0" FontSize="13"
                      AutomationProperties.Name="{l:Loc Dialog.OptionalConnectionOptions}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Margin="10,8">
                        <TextBlock Text="&#xE713;" Style="{StaticResource GlyphStyle}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Dialog.MoreConnectionOptions}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
            <Grid Margin="0,12,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="{l:Loc Dialog.OptionalNameLabel}" Target="{Binding ElementName=QuickNameBox}"
                           Style="{StaticResource QuickFieldLabelStyle}" />
                    <TextBox x:Name="QuickNameBox" Text="{Binding ManualName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource QuickTextBoxStyle}" MaxLength="100"
                             ToolTip="{l:Loc Dialog.OptionalNameHint}"
                             AutomationProperties.Name="{l:Loc Dialog.OptionalName}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="{l:Loc Dialog.OptionalKeyLabel}" Target="{Binding ElementName=QuickKeyBox}"
                           Style="{StaticResource QuickFieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickKeyBox"
                                 Text="{Binding ManualPrivateKeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource QuickTextBoxStyle}"
                                 ToolTip="{l:Loc Dialog.OptionalKeyHint}"
                                 AutomationProperties.Name="{l:Loc Dialog.OptionalKey}" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Width="36" Height="38" Padding="0"
                                Click="BrowsePrivateKey_Click" ToolTip="{l:Loc Dialog.BrowseKey}"
                                AutomationProperties.Name="{l:Loc Dialog.BrowseKeyFile}">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource GlyphStyle}" FontSize="16" />
                        </Button>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Label Content="{l:Loc Dialog.ShortTimeoutLabel}" Target="{Binding ElementName=QuickTimeoutBox}"
                           Style="{StaticResource QuickFieldLabelStyle}" />
                    <TextBox x:Name="QuickTimeoutBox" Width="120" HorizontalAlignment="Left" MaxLength="3"
                             Text="{Binding ManualConnectionTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource QuickTextBoxStyle}" AutomationProperties.Name="{l:Loc Dialog.Timeout}" />
                </StackPanel>
            </Grid>
            </Expander>

            <TextBlock x:Name="QuickErrorText" Text="{Binding ConnectionError}"
                       Foreground="{DynamicResource DangerBrush}" FontSize="13" TextWrapping="Wrap"
                       Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ConnectionError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConnectionError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar Width="70" Height="4" IsIndeterminate="True" Margin="0,0,10,0"
                                 AutomationProperties.Name="{l:Loc Dialog.ConnectionInProgress}" />
                    <TextBlock Text="{l:Loc Dialog.Connecting}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Loc Dialog.Cancel}" Command="{Binding CancelConnectionCommand}" MinWidth="90" MinHeight="38"
                            Margin="0,0,8,0" AutomationProperties.Name="{l:Loc Dialog.CancelConnection}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="QuickSaveButton" Content="{l:Loc Dialog.SaveVps}" Command="{Binding SaveManualConnectionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" MinHeight="38" Margin="0,0,8,0"
                            ToolTip="{l:Loc Dialog.SaveWithoutConnectHint}"
                            AutomationProperties.Name="{l:Loc Dialog.SaveWithoutConnect}" />
                    <Button x:Name="QuickConnectButton" Command="{Binding ManualConnectCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="114" MinHeight="38"
                            ToolTip="{l:Loc Dialog.ConnectHint}"
                            AutomationProperties.Name="{l:Loc Dialog.ManualConnect}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE839;" Style="{StaticResource GlyphStyle}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Loc Dialog.Connect}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
