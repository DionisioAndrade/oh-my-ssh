<Window x:Class="OhMySsh.Desktop.Views.OverwriteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OhMySsh.Desktop.Localization"
        Title="{l:Loc Dialog.ReplaceFile}" Width="590" MinWidth="480" SizeToContent="Height" MaxHeight="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{l:Loc Dialog.ReplaceQuestion}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="LocationText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{l:Loc Dialog.DestinationFile}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                <TextBox x:Name="DestinationTextBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0"
                         AutomationProperties.Name="{l:Loc Dialog.ReplaceFileName}" />
                <TextBlock Text="{l:Loc Dialog.ReplaceHint}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Loc Dialog.Cancel}" IsCancel="True" Style="{DynamicResource SecondaryButtonStyle}" MinWidth="100" MinHeight="38" Margin="0,0,8,0" />
            <Button Content="{l:Loc Dialog.ReplaceFile}" Click="Replace_Click" Style="{DynamicResource PrimaryButtonStyle}" MinWidth="150" MinHeight="38" />
        </StackPanel>
    </Grid>
</Window>
