<Window x:Class="OhMySsh.Desktop.Views.TerminalRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OhMySsh.Desktop.Localization"
        Title="{l:Loc TerminalControls.RenameTab}" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="Window_Loaded">
    <StackPanel Margin="22">
        <Label Content="{l:Loc TerminalControls.TabName}" Target="{Binding ElementName=TabNameBox}" Padding="0,0,0,7" FontWeight="SemiBold" />
        <TextBox x:Name="TabNameBox" MaxLength="64" MinHeight="34" AutomationProperties.Name="{l:Loc TerminalControls.TabName}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Loc Dialog.Cancel}" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
            <Button x:Name="SaveTabNameButton" Content="{l:Loc Dialog.SaveChanges}" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
