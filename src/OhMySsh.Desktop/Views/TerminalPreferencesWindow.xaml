<Window x:Class="OhMySsh.Desktop.Views.TerminalPreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OhMySsh.Desktop.Localization"
        xmlns:terminal="clr-namespace:OhMySsh.Desktop.Terminal"
        Title="{l:Loc TerminalPreferences.Title}" Width="880" Height="760" MinWidth="760" MinHeight="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="PreferenceLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PreferenceHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <DataTemplate x:Key="ColorFieldTemplate">
            <StackPanel Margin="0,0,14,14">
                <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,0,5" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Background="{Binding Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0"
                            Width="28" Height="30" HorizontalAlignment="Left" Click="ChooseColor_Click" ToolTip="{l:Loc TerminalPreferences.ChooseColor}"
                            AutomationProperties.Name="{Binding Label}" />
                    <TextBox Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" MinWidth="72" Height="30"
                             Padding="5,3" FontFamily="Consolas" FontSize="12" ToolTip="{l:Loc TerminalPreferences.ColorFormat}" AutomationProperties.Name="{Binding Label}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="24,22,24,16">
            <TextBlock Text="{l:Loc TerminalPreferences.Title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{l:Loc TerminalPreferences.Description}" Style="{StaticResource PreferenceHint}" />
        </StackPanel>
        <Border x:Name="PreviewBorder" Grid.Row="1" Margin="24,0,24,16" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" ClipToBounds="True" Height="160">
            <terminal:TerminalSurface x:Name="PreviewSurface" IsInputEnabled="False" Focusable="False" PreviewCursor="True"
                                      DimensionsChanged="Preview_DimensionsChanged" AutomationProperties.Name="{l:Loc TerminalPreferences.Preview}" />
        </Border>
        <TabControl x:Name="PreferencesTabs" Grid.Row="2" Margin="24,0,24,0" Style="{StaticResource FluentTabControlStyle}" ItemContainerStyle="{StaticResource FluentTabItemStyle}">
            <TabItem Header="{l:Loc TerminalPreferences.Typography}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,18,8,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{l:Loc TerminalPreferences.FontFamily}" Style="{StaticResource PreferenceLabel}" />
                                <ComboBox x:Name="TerminalFontFamily" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}" MinHeight="34" AutomationProperties.Name="{l:Loc TerminalPreferences.FontFamily}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{l:Loc TerminalPreferences.FontWeight}" Style="{StaticResource PreferenceLabel}" />
                                <ComboBox ItemsSource="{Binding FontWeights}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FontWeight}" MinHeight="34" AutomationProperties.Name="{l:Loc TerminalPreferences.FontWeight}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:Loc TerminalPreferences.FontHint}" Style="{StaticResource PreferenceHint}" />
                        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Loc TerminalPreferences.FontSize}" Style="{StaticResource PreferenceLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="TerminalFontSize" Minimum="8" Maximum="32" TickFrequency=".5" IsSnapToTickEnabled="True" Value="{Binding FontSize}" AutomationProperties.Name="{l:Loc TerminalPreferences.FontSize}" />
                        <CheckBox x:Name="TerminalLigatures" Content="{l:Loc TerminalPreferences.Ligatures}" IsChecked="{Binding Ligatures}" Margin="0,16,0,0" />
                        <TextBlock Text="{l:Loc TerminalPreferences.LigaturesHint}" Style="{StaticResource PreferenceHint}" />
                        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{l:Loc TerminalPreferences.LineHeight}" Style="{StaticResource PreferenceLabel}" />
                                <Slider Minimum="1" Maximum="2" TickFrequency=".05" IsSnapToTickEnabled="True" Value="{Binding LineHeight}" AutomationProperties.Name="{l:Loc TerminalPreferences.LineHeight}" />
                                <TextBlock Text="{Binding LineHeightLabel}" Style="{StaticResource PreferenceHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{l:Loc TerminalPreferences.Padding}" Style="{StaticResource PreferenceLabel}" />
                                <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Padding}" AutomationProperties.Name="{l:Loc TerminalPreferences.Padding}" />
                                <TextBlock Text="{Binding PaddingLabel}" Style="{StaticResource PreferenceHint}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Loc TerminalPreferences.Colors}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,18,0,12">
                        <TextBlock Text="{l:Loc TerminalPreferences.Palette}" Style="{StaticResource PreferenceLabel}" />
                        <ComboBox ItemsSource="{Binding PalettePresets}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding PalettePreset}" MinHeight="34" Margin="0,0,14,16" AutomationProperties.Name="{l:Loc TerminalPreferences.Palette}" />
                        <UniformGrid Columns="4">
                            <ContentControl Content="{Binding ForegroundField}" ContentTemplate="{StaticResource ColorFieldTemplate}" />
                            <ContentControl Content="{Binding BackgroundField}" ContentTemplate="{StaticResource ColorFieldTemplate}" />
                            <ContentControl Content="{Binding CursorField}" ContentTemplate="{StaticResource ColorFieldTemplate}" />
                            <ContentControl Content="{Binding SelectionField}" ContentTemplate="{StaticResource ColorFieldTemplate}" />
                        </UniformGrid>
                        <TextBlock Text="{l:Loc TerminalPreferences.AnsiPalette}" Style="{StaticResource PreferenceLabel}" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding PaletteColors}" ItemTemplate="{StaticResource ColorFieldTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <CheckBox Content="{l:Loc TerminalPreferences.BoldBright}" IsChecked="{Binding BoldBrightColors}" Margin="0,2,0,0" />
                        <TextBlock Text="{l:Loc TerminalPreferences.PaletteHint}" Style="{StaticResource PreferenceHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Loc TerminalPreferences.CursorAndSelection}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,18,16,12">
                        <TextBlock Text="{l:Loc TerminalPreferences.CursorShape}" Style="{StaticResource PreferenceLabel}" />
                        <ComboBox ItemsSource="{Binding CursorStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CursorStyle}" MinHeight="34" AutomationProperties.Name="{l:Loc TerminalPreferences.CursorShape}" />
                        <CheckBox Content="{l:Loc TerminalPreferences.CursorBlink}" IsChecked="{Binding CursorBlink}" Margin="0,18,0,0" />
                        <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Loc TerminalPreferences.SelectionOpacity}" Style="{StaticResource PreferenceLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectionOpacityLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <Slider Minimum=".1" Maximum=".9" TickFrequency=".05" IsSnapToTickEnabled="True" Value="{Binding SelectionOpacity}" AutomationProperties.Name="{l:Loc TerminalPreferences.SelectionOpacity}" />
                        <TextBlock Text="{l:Loc TerminalPreferences.CursorHint}" Style="{StaticResource PreferenceHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Loc TerminalPreferences.History}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,18,16,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Loc TerminalPreferences.Scrollback}" Style="{StaticResource PreferenceLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding ScrollbackLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="TerminalScrollback" Minimum="500" Maximum="10000" TickFrequency="500" IsSnapToTickEnabled="True" Value="{Binding ScrollbackLines}" AutomationProperties.Name="{l:Loc TerminalPreferences.Scrollback}" />
                        <TextBlock Text="{l:Loc TerminalPreferences.ScrollbackHint}" Style="{StaticResource PreferenceHint}" />
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="14" Margin="0,24,0,0">
                            <TextBlock Text="{l:Loc TerminalPreferences.PrivacyHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Margin="24,12,24,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        <Border Grid.Row="4" BorderBrush="{DynamicResource MutedBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16" Margin="0,14,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Content="{l:Loc TerminalPreferences.RestoreDefaults}" Click="RestoreDefaults_Click" HorizontalAlignment="Left" Padding="12,7" IsEnabled="{Binding CanEdit}" />
                <Button Grid.Column="1" Content="{l:Loc TerminalPreferences.Cancel}" Click="Cancel_Click" Padding="18,7" MinWidth="88" Margin="12,0,8,0" IsCancel="True" />
                <Button x:Name="SaveTerminalPreferencesButton" Grid.Column="2" Content="{l:Loc TerminalPreferences.Save}" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="18,7" MinWidth="100" IsEnabled="{Binding CanSave}" />
            </Grid>
        </Border>
    </Grid>
</Window>
