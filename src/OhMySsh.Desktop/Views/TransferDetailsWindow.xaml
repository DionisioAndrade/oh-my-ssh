<Window x:Class="OhMySsh.Desktop.Views.TransferDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OhMySsh.Desktop.Localization"
        Title="{l:Loc Dialog.TransferDetails}" Width="710" Height="690" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{l:Loc Dialog.TransferFailed}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock x:Name="FailureSummaryText" Text="{Binding FailureSummary}" FontSize="24" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dialog.WhatHappened}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock x:Name="FailureReasonText" Text="{Binding FailureReason}" TextWrapping="Wrap" TextTrimming="None"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="7" Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Dialog.NextStep}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock x:Name="SuggestedActionText" Text="{Binding SuggestedAction}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dialog.File}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{l:Loc Dialog.Operation}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DirectionLabel}" />
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,18,0,0">
                    <TextBlock Text="VPS" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ConnectionName}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{Binding Profile.Host}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
                <StackPanel Margin="0,18,0,0">
                    <TextBlock Text="{l:Loc Dialog.Source}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="70"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{l:Loc Dialog.TransferSourcePath}" />
                    <TextBlock Text="{l:Loc Dialog.Destination}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,6" />
                    <TextBox Text="{Binding DestinationPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="70"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{l:Loc Dialog.TransferDestinationPath}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="{l:Loc Dialog.Close}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,20,0,0"
                Style="{DynamicResource SecondaryButtonStyle}" MinWidth="100" MinHeight="38" />
    </Grid>
</Window>
