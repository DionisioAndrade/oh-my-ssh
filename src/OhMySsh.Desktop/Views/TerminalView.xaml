<UserControl x:Class="OhMySsh.Desktop.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OhMySsh.Desktop.Localization"
             xmlns:terminal="clr-namespace:OhMySsh.Desktop.Terminal"
             DataContextChanged="View_DataContextChanged">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource MutedBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Endpoint}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Endpoint}" />
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenTerminalButton" Content="{l:Loc Terminal.Open}" Command="{Binding OpenCommand}" Click="OpenTerminal_Click"
                            Style="{DynamicResource PrimaryButtonStyle}" FontSize="12" MinHeight="30" Padding="10,4" />
                    <Button x:Name="CloseTerminalButton" Content="{l:Loc Terminal.Close}" Command="{Binding CloseCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}" FontSize="12" MinHeight="30" Padding="10,4" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource TerminalBrush}" ClipToBounds="True" Padding="10,6">
            <Grid>
                <terminal:TerminalSurface x:Name="TerminalDisplay" Emulator="{Binding Emulator}" IsInputEnabled="{Binding IsOpen}"
                                          FontFamily="{StaticResource MonoFont}" FontSize="13" DimensionsChanged="Terminal_DimensionsChanged"
                                          OperationFailed="Terminal_OperationFailed" AutomationProperties.Name="{l:Loc Terminal.Surface}" />
                <TextBlock Text="{l:Loc Terminal.OpenHint}" Foreground="{DynamicResource TerminalTextBrush}" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="480" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasEmulator, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="10,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{l:Loc Terminal.Instructions}" ToolTip="{l:Loc Terminal.Instructions}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Dimensions}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
