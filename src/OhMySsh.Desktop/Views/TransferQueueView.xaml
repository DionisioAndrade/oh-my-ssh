<UserControl x:Class="OhMySsh.Desktop.Views.TransferQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DataGrid x:Name="TransferJobsGrid" ItemsSource="{Binding TransferJobs}" Style="{StaticResource FileGridStyle}"
                  AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource FileColumnHeaderStyle}" CellStyle="{StaticResource FileCellStyle}"
                  RowHeight="52" IsReadOnly="True" CanUserSortColumns="False" AutomationProperties.Name="Fila de transferências">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Arquivo / VPS" Width="190" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" ToolTip="{Binding DestinationPath}" /><TextBlock Text="{Binding Profile.Host}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Direção" Binding="{Binding DirectionLabel}" Width="75">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Progresso" Width="*" MinWidth="160">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="0,7"><Grid.RowDefinitions><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions><ProgressBar Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="5" /><Grid Grid.Row="1" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding BytesLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0.#}%}" FontSize="10" Margin="8,0,0,0" /></Grid></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="105">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusLabel}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Error}" AutomationProperties.HelpText="{Binding Error}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="85">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Cancelar" Command="{Binding DataContext.CancelTransferCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="8,4" MinHeight="28" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding FileName, StringFormat='Cancelar transferência de {0}'}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Nenhuma transferência na fila. Envie ou baixe um arquivo para começar."
                   Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="20,35,20,15" IsHitTestVisible="False"
                   Visibility="{Binding HasTransfers, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
