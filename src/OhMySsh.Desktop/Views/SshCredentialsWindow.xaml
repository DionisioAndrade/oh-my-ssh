<Window x:Class="OhMySsh.Desktop.Views.SshCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH authentication" Width="560" Height="440" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" MaxHeight="720"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SSH authentication" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="EndpointText" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,20" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="MethodText" FontWeight="SemiBold" />
                <TextBlock x:Name="KeyPathText" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                <Label x:Name="SecretLabel" Content="_Password" Target="{Binding ElementName=SecretBox}"
                       Padding="0,16,0,6" />
                <PasswordBox x:Name="SecretBox" MinHeight="38" VerticalContentAlignment="Center"
                             AutomationProperties.Name="SSH password or private-key passphrase" />
                <CheckBox x:Name="RememberCheckBox" Content="Remember in Windows Credential Manager"
                          Margin="0,16,0,0" />
                <TextBlock x:Name="StorageHintText" Text="The profile stores no passwords or private-key contents."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{DynamicResource SecondaryButtonStyle}"
                    MinWidth="100" MinHeight="38" Margin="0,0,8,0" />
            <Button Content="Connect" IsDefault="True" Click="Connect_Click" Style="{DynamicResource PrimaryButtonStyle}"
                    MinWidth="120" MinHeight="38" />
        </StackPanel>
    </Grid>
</Window>
