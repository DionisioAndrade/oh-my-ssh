<Window x:Class="OhMySsh.Desktop.Views.SshCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH authentication" Width="610" MinWidth="520" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" MaxHeight="760"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="SSH authentication" FontSize="26" FontWeight="SemiBold" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="EndpointText" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                <Button x:Name="CopyIpButton" Grid.Column="1" Content="Copy IP" Click="CopyIp_Click" Style="{DynamicResource SecondaryButtonStyle}"
                        FontSize="12" Padding="10,4" MinHeight="30" ToolTip="Copy the server address without the username or port." AutomationProperties.Name="Copy VPS IP or hostname" />
            </Grid>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="MethodText" FontWeight="SemiBold" />
                <TextBlock x:Name="KeyPathText" Text="A private-key file is selected. Enter its passphrase only if the file is encrypted."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                <Label x:Name="SecretLabel" Content="_Password" Target="{Binding ElementName=SecretBox}" Padding="0,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <PasswordBox x:Name="SecretBox" MinHeight="38" VerticalContentAlignment="Center" PasswordChanged="SecretBox_PasswordChanged"
                                 AutomationProperties.Name="SSH password or private-key passphrase" />
                    <TextBox x:Name="RevealedSecretBox" Visibility="Collapsed" IsReadOnly="True" IsUndoEnabled="False" UndoLimit="0"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" ContextMenu="{x:Null}" MinHeight="38" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Temporarily revealed SSH secret" />
                    <Button x:Name="RevealSecretButton" Grid.Column="1" Content="Show" Click="RevealSecret_Click"
                            Style="{DynamicResource SecondaryButtonStyle}" Padding="10,4" MinWidth="65" MinHeight="38" Margin="8,0,0,0"
                            ToolTip="Confirm your current Windows account password to reveal this secret temporarily." AutomationProperties.Name="Show or hide SSH secret" />
                </Grid>
                <Button x:Name="CopySecretButton" Content="Copy password" Click="CopySecret_Click" HorizontalAlignment="Left"
                        Style="{DynamicResource SecondaryButtonStyle}" FontSize="12" Padding="10,4" MinHeight="30" Margin="0,10,0,0"
                        ToolTip="Confirm your current Windows account password before copying. The app clears its clipboard entry after 30 seconds." />
                <TextBlock Text="Your Windows account password is required to show or copy this secret. Windows PIN and biometric sign-in are not supported here."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="RememberCheckBox" Content="Remember in Windows Credential Manager" Margin="0,16,0,0" />
                <TextBlock x:Name="StorageHintText" Text="Only non-secret connection settings belong in a profile. Passwords and passphrases stay separate."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{DynamicResource SecondaryButtonStyle}" MinWidth="100" MinHeight="38" Margin="0,0,8,0" />
            <Button x:Name="ConnectButton" Content="Connect" IsDefault="True" Click="Connect_Click"
                    Style="{DynamicResource PrimaryButtonStyle}" MinWidth="120" MinHeight="38" />
        </StackPanel>
    </Grid>
</Window>
