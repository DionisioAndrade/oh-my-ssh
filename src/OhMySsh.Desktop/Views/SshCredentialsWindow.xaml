<Window x:Class="OhMySsh.Desktop.Views.SshCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OhMySsh.Desktop.Localization"
        Title="{l:Loc Dialog.SshAuthentication}" Width="610" MinWidth="520" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" MaxHeight="760"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{l:Loc Dialog.SshAuthentication}" FontSize="26" FontWeight="SemiBold" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="EndpointText" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                <Button x:Name="CopyIpButton" Grid.Column="1" Content="{l:Loc Dialog.CopyIp}" Click="CopyIp_Click" Style="{DynamicResource SecondaryButtonStyle}"
                        FontSize="12" Padding="10,4" MinHeight="30" ToolTip="{l:Loc Dialog.CopyIpHint}" AutomationProperties.Name="{l:Loc Dialog.CopyIpName}" />
            </Grid>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="MethodText" FontWeight="SemiBold" />
                <TextBlock x:Name="KeyPathText" Text="{l:Loc Dialog.KeySelectedHint}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                <Label x:Name="SecretLabel" Content="{l:Loc Dialog.PasswordLabel}" Target="{Binding ElementName=SecretBox}" Padding="0,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <PasswordBox x:Name="SecretBox" MinHeight="38" VerticalContentAlignment="Center" PasswordChanged="SecretBox_PasswordChanged"
                                 AutomationProperties.Name="{l:Loc Dialog.SecretName}" />
                    <TextBox x:Name="RevealedSecretBox" Visibility="Collapsed" IsReadOnly="True" IsUndoEnabled="False" UndoLimit="0"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" ContextMenu="{x:Null}" MinHeight="38" VerticalContentAlignment="Center"
                             AutomationProperties.Name="{l:Loc Dialog.RevealedSecretName}" />
                    <Button x:Name="RevealSecretButton" Grid.Column="1" Content="{l:Loc Dialog.Show}" Click="RevealSecret_Click"
                            Style="{DynamicResource SecondaryButtonStyle}" Padding="10,4" MinWidth="65" MinHeight="38" Margin="8,0,0,0"
                            ToolTip="{l:Loc Dialog.RevealHint}" AutomationProperties.Name="{l:Loc Dialog.RevealName}" />
                </Grid>
                <Button x:Name="CopySecretButton" Content="{l:Loc Dialog.CopyPassword}" Click="CopySecret_Click" HorizontalAlignment="Left"
                        Style="{DynamicResource SecondaryButtonStyle}" FontSize="12" Padding="10,4" MinHeight="30" Margin="0,10,0,0"
                        ToolTip="{l:Loc Dialog.CopySecretHint}" />
                <TextBlock Text="{l:Loc Dialog.WindowsPasswordHint}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="RememberCheckBox" Content="{l:Loc Dialog.RememberCredentials}" Margin="0,16,0,0" />
                <TextBlock x:Name="StorageHintText" Text="{l:Loc Dialog.StorageHint}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Loc Dialog.Cancel}" IsCancel="True" Style="{DynamicResource SecondaryButtonStyle}" MinWidth="100" MinHeight="38" Margin="0,0,8,0" />
            <Button x:Name="ConnectButton" Content="{l:Loc Dialog.Connect}" IsDefault="True" Click="Connect_Click"
                    Style="{DynamicResource PrimaryButtonStyle}" MinWidth="120" MinHeight="38" />
        </StackPanel>
    </Grid>
</Window>
