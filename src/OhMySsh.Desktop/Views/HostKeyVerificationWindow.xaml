<Window x:Class="OhMySsh.Desktop.Views.HostKeyVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OhMySsh.Desktop.Localization"
        Title="{l:Loc Dialog.VerifyServer}" Width="650" Height="430" MinWidth="580" MinHeight="410"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" MaxHeight="720"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{l:Loc Dialog.VerifyServer}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{l:Loc Dialog.VerifyServerHint}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{l:Loc Dialog.Server}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="ServerText" FontWeight="SemiBold" Margin="0,4,0,14" TextWrapping="Wrap" />
                <TextBlock x:Name="AlgorithmText" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="FingerprintTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0" Padding="0"
                         AutomationProperties.Name="{l:Loc Dialog.Fingerprint}" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Loc Dialog.Cancel}" IsCancel="True" Style="{DynamicResource SecondaryButtonStyle}"
                    MinWidth="85" MinHeight="38" Margin="0,0,8,0" />
            <Button Content="{l:Loc Dialog.TrustOnce}" Click="TrustOnce_Click" Style="{DynamicResource SecondaryButtonStyle}"
                    MinWidth="110" MinHeight="38" Margin="0,0,8,0" />
            <Button Content="{l:Loc Dialog.TrustRemember}" Click="TrustAndRemember_Click" Style="{DynamicResource PrimaryButtonStyle}"
                    MinWidth="170" MinHeight="38" />
        </StackPanel>
    </Grid>
</Window>
